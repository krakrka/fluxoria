# REQUIRED
# Vercel runtime: Neon pooled host, with sslmode=require and pgbouncer=true on the value.
DATABASE_URL=
# Migrations only. Neon direct host, without the pooler. Local unpooled PostgreSQL: repeat DATABASE_URL.
# npm run db:deploy reads this name. It does not fall back to a pooled DATABASE_URL.
DIRECT_URL=
AUTH_SECRET=
AUTH_URL=

# OPTIONAL — public origin used by email, OAuth and billing links. Falls back to AUTH_URL.
APP_URL=

# REQUIRED in production: s3. local is development only.
# Production boot refuses local storage and refuses to start if a required S3 name is empty.
# S3_ENDPOINT stays empty for AWS. A compatible endpoint must be https in production.
# Filling these names does not prove a live bucket. No live check has been run.
STORAGE_DRIVER=
STORAGE_LOCAL_DIR=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# OPTIONAL — probe only. Leave empty. A bucket name is not proof of isolation.
# Start only with S3_LIVE_CHECK=true and S3_LIVE_CONFIRM=isolated, outside NODE_ENV=production.
# The probe bucket and its keys must differ from S3_BUCKET and the application keys.
# npm test does not call a provider. A successful probe does not make application storage operational.
S3_LIVE_CHECK=
S3_LIVE_CONFIRM=
S3_LIVE_BUCKET=
S3_LIVE_REGION=
S3_LIVE_ENDPOINT=
S3_LIVE_ACCESS_KEY_ID=
S3_LIVE_SECRET_ACCESS_KEY=
MAX_UPLOAD_BYTES=

# DEVELOPMENT_ONLY unless a real extraction key is configured.
MOCK_AI_MODE=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_VISION_MODEL=

# OPTIONAL — interchangeable HTTP email provider.
EMAIL_DELIVERY_ENABLED=
EMAIL_API_URL=
EMAIL_API_KEY=
SUPPORT_INBOX=

# OPTIONAL — absent means billing is not configured and the app keeps running.
TRIAL_DAYS=
PLAN_STARTER_PRICE_CENTS=
PLAN_PRO_PRICE_CENTS=
PLAN_BUSINESS_PRICE_CENTS=
PLAN_STARTER_DOCUMENTS=
PLAN_PRO_DOCUMENTS=
PLAN_BUSINESS_DOCUMENTS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# OPTIONAL — error tracking and alerts. Bodies are redacted.
ERROR_TRACKING_URL=
SENTRY_DSN=
ALERT_WEBHOOK_URL=
LOG_LEVEL=

# OPTIONAL — status page editors. Empty means nobody can publish an incident.
STATUS_LEVEL=
STATUS_EDITOR_EMAILS=

# PRODUCTION_ONLY — set true only after a restore test.
BACKUP_CONFIGURED=

# DEVELOPMENT_ONLY — must stay empty or false in production.
EXPOSE_RESET_LINK=
DEMO_LOGIN_HINT=

# OPTIONAL connectors.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INBOUND_WEBHOOK_SECRET=
